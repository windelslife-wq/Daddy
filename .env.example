# -----------------------------------------------------------------------------
# Faceless Studio — server environment. Copy to .env for local development.
# Never commit real secrets. Frontend code never reads these variables.
# -----------------------------------------------------------------------------

# Core
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
APP_NAME=Faceless Studio
APP_URL=http://localhost:8787
# Must be the exact HTTPS origin registered with OAuth providers in production.
# Instagram needs a public HTTPS URL so Meta can fetch rendered videos.
PUBLIC_BASE_URL=http://localhost:8787
TRUST_PROXY=true
SECURE_COOKIES=false
LOG_LEVEL=debug
API_RATE_LIMIT_PER_MINUTE=600

# Persistence. SQLite works locally; Postgres is recommended for multi-process production.
# DATABASE_URL=postgresql://user:password@host:5432/faceless_studio
SQLITE_PATH=data/app.sqlite3
DATA_DIR=data
STORAGE_DIR=storage

# Required in production: base64-encoded 32 random bytes.
# Generate: openssl rand -base64 32
# In development a key is written to data/development.key automatically.
# APP_ENCRYPTION_KEY=

# Seed accounts. Disable SEED_DEMO in real production.
SEED_DEMO=true
EXPOSE_DEMO_CREDENTIALS=true
DEMO_EMAIL=creator@faceless.local
DEMO_PASSWORD=StudioDemo2026!
ADMIN_EMAIL=admin@faceless.local
ADMIN_PASSWORD=AdminStudio2026!

# Background worker
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000
WORKER_MAX_ATTEMPTS=5
JOB_TIMEOUT_MS=1200000

# AI script provider. local works offline.
# openai | anthropic | gemini require the matching key below.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MAX_SCENES=8

# Optional research provider. none works offline.
# brave: SEARCH_API_KEY is a Brave Search API key.
# tavily: SEARCH_API_KEY is a Tavily API key.
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# Image generation. procedural works offline and creates original SVG scene art.
# openai: OPENAI_API_KEY + image model. replicate: REPLICATE_API_TOKEN + model.
IMAGE_PROVIDER=procedural
OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# Text to speech. mespeak works offline.
# openai: OPENAI_API_KEY. elevenlabs: ELEVENLABS_API_KEY + voice ID.
TTS_PROVIDER=mespeak
OPENAI_TTS_MODEL=gpt-4o-mini-tts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional explicit FFmpeg binary path. Leave empty to use @ffmpeg-installer/ffmpeg.
FFMPEG_PATH=

# Meta / Facebook Pages / Instagram Business OAuth
# Create a Meta app with Facebook Login for Business. Request Advanced Access for
# pages_show_list, pages_read_engagement, pages_manage_posts, instagram_basic,
# instagram_content_publish, and instagram_manage_insights. App Review and
# Business Verification may be required for permissions used by real users.
# Instagram Login apps use instagram_business_* scopes and a different host.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# Google / YouTube OAuth
# Enable YouTube Data API v3, YouTube Analytics API, and YouTube Reporting API.
# Use an OAuth client with a verified test user or published consent screen.
# Reconnect existing channels to grant yt-analytics.readonly for watch time and
# thumbnail impressions. Uploading consumes YouTube API quota.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X OAuth 1.0a user context
# Configure a web app with read/write permissions and callback URL.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=

# Stripe subscriptions. Paid checkout is disabled until these are configured.
# Also set a Stripe Price ID on each paid plan in Admin → Plans.
# Webhook events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional email/webhook notifications
SMTP_URL=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_FROM=Faceless Studio <notifications@example.com>

# Session lifetime
SESSION_TTL_DAYS=14

# Advanced: official API endpoint overrides. Leave empty to use the official hosts.
# Use only for approved API gateways, enterprise proxies, or isolated integration tests.
# Production rejects non-HTTPS overrides.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# BRAVE_BASE_URL=https://api.search.brave.com/res/v1/web
# TAVILY_BASE_URL=https://api.tavily.com
# REPLICATE_BASE_URL=https://api.replicate.com/v1
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
# META_GRAPH_BASE_URL=https://graph.facebook.com
# META_AUTH_BASE_URL=https://www.facebook.com
# GOOGLE_API_BASE_URL=https://www.googleapis.com
# GOOGLE_UPLOAD_BASE_URL=https://www.googleapis.com/upload/youtube/v3
# GOOGLE_ANALYTICS_BASE_URL=https://youtubeanalytics.googleapis.com/v2
# GOOGLE_REPORTING_BASE_URL=https://youtubereporting.googleapis.com/v1
# GOOGLE_OAUTH_BASE_URL=https://oauth2.googleapis.com
# GOOGLE_AUTH_BASE_URL=https://accounts.google.com
# X_API_BASE_URL=https://api.x.com/2
# X_OAUTH_BASE_URL=https://api.x.com
# X_UPLOAD_BASE_URL=https://upload.twitter.com/1.1/media/upload.json
# STRIPE_API_BASE_URL=https://api.stripe.com/v1

# Signed notification webhook delivery. The server sends X-Faceless-Signature.
# NOTIFICATION_WEBHOOK_SECRET=
# NOTIFICATION_WEBHOOK_TIMEOUT_MS=10000
