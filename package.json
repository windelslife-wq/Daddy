{
  "name": "faceless-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-powered faceless video creation and social media automation platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/index.js",
    "start": "npm run build && NODE_ENV=production node server/index.js",
    "build": "vite build",
    "preview": "npm run build && NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:integrations": "node --test tests/provider-integrations.test.js tests/external-services.test.js",
    "test:e2e": "node tests/e2e.js",
    "test:visual": "npm run build && node --test tests/visual.js",
    "test:all": "npm test && npm run test:e2e && npm run test:visual"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.10.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "knex": "^3.1.0",
    "lucide-react": "^0.468.0",
    "mespeak": "^2.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^7.0.13",
    "oauth-1.0a": "^2.2.6",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sharp": "^0.35.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "pg-mem": "^3.0.14",
    "playwright-core": "^1.64.1",
    "smtp-server": "^3.21.1",
    "vite": "^5.4.21"
  }
}
